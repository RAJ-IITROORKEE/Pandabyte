# Match the BFF's PANDA_AGENT_LIGHTWEIGHT_SECRET; never commit the filled file.
PANDA_LIGHTWEIGHT_SECRET=
PANDA_LIGHTWEIGHT_JOURNAL=/data/lightweight.sqlite
# Opt-in deterministic guide workflow; no model/provider is enabled by this flag.
PANDA_LIGHTWEIGHT_GUIDE_ENABLED=false
# Empty disables selection; deterministic-mcu-v1 enables the reviewed zero-call MCU field selector.
# Model profiles remain unavailable until individually approved in PROFILES_V1.
PANDA_LIGHTWEIGHT_PROFILE=
PANDA_LIGHTWEIGHT_OPENROUTER_KEY=

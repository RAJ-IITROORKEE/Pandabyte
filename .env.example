# Copy to .env.local only after selecting the owner-approved test/staging projects.
# Empty placeholders are intentional; no authentication bypass is provided.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public client configuration still requires reviewed grants/RLS and Clerk integration.
NEXT_PUBLIC_INSFORGE_BASE_URL=
# Server-only anonymous read/submission client; the Clerk bridge uses user tokens.
# Use the actual InsForge Anon Key, never a project admin API key.
INSFORGE_ANON_KEY=
# Server-only fallback for published editorial file reads on restricted InsForge Cloud.
# This is a privileged project key; never expose it to client code or use it for app writes.
INSFORGE_EDITORIAL_STORAGE_READ_KEY=
# Do not put admin/database/signing secrets in NEXT_PUBLIC_ variables.

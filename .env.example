# Copy to .env.local only after selecting the owner-approved test/staging projects.
# Empty placeholders are intentional; no authentication bypass is provided.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public client configuration still requires reviewed grants/RLS and Clerk integration.
NEXT_PUBLIC_INSFORGE_BASE_URL=
# Server-only Clerk template for this backend; omit for the historical insforge default.
# Set the existing reviewed template when using a migrated backend.
INSFORGE_CLERK_JWT_TEMPLATE=insforge
# Server-only anonymous read client; the Clerk bridge uses user tokens.
# Use the actual InsForge Anon Key, never a project admin API key.
INSFORGE_ANON_KEY=
# Server-only fallback for published editorial file reads on restricted InsForge Cloud.
# This is a privileged project key; never expose it to client code or use it for app writes.
INSFORGE_EDITORIAL_STORAGE_READ_KEY=
# Separate server-only proof for GLB validation/registration. Store its SHA-256 in the
# private product_model_validation_config row; never reuse the storage admin key.
PRODUCT_MODEL_VALIDATION_KEY=
# Do not put admin/database/signing secrets in NEXT_PUBLIC_ variables.

# Contact protection: submissions fail closed until all fields and the DB hash match.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_SUBMISSION_KEY=
CONTACT_SITE_ORIGIN=
# live requires HTTPS + real keys. local-test is explicit loopback-only test behavior.
CONTACT_TURNSTILE_MODE=

# Inquiry email preparation: keep false until paid email access and recipient are verified.
INQUIRY_EMAIL_ENABLED=false
INQUIRY_EMAIL_TO=
# Separate server-only scoped dispatch proof; never use a project-admin key here.
INQUIRY_NOTIFICATION_KEY=

# Disposable development checkout simulation only; never enable for production.
# A separate actor/variant fixture grant and matching DB proof hash are also required.
PANDABYTE_COMMERCE_SIMULATION=false
COMMERCE_SIMULATION_KEY=

# Isolated local Razorpay TEST checkout; defaults off. Provider secrets belong in InsForge.
# Requires private disposable actor/stock grants and the matching DB proof hash.
PANDABYTE_RAZORPAY_TEST_ENABLED=false
RAZORPAY_CHECKOUT_TEST_KEY=
RAZORPAY_TEST_KEY_ID=
# Additional localhost development storefront test flow; requires matching DB config/proof/key.
PANDABYTE_STOREFRONT_TEST_ENABLED=false

# Fresh Panda Agent only. Explicitly verify its existing corpus target and Clerk template.
# These never fall back to the storefront's NEXT_PUBLIC_* configuration.
PANDA_AGENT_LIGHTWEIGHT_ENABLED=false
# Guides also require the private worker flag and a reviewed, enabled Admin skill.
PANDA_AGENT_GUIDES_ENABLED=false
# Optional diagnostics. These do not enable vision or an external model provider.
PANDA_AGENT_DIAGNOSTICS_ENABLED=false
PANDA_AGENT_IMAGES_ENABLED=false
PANDA_AGENT_VENDOR_SEARCH_ENABLED=false
PANDA_AGENT_AGENTIC_ENABLED=false
# Empty retains the reviewed model path (currently unconfigured); explicit zero-call MCU fields:
PANDA_AGENT_LIGHTWEIGHT_MODE=
PANDA_AGENT_INSFORGE_BASE_URL=
PANDA_AGENT_CLERK_JWT_TEMPLATE=
PANDA_AGENT_LIGHTWEIGHT_URL=http://127.0.0.1:8080
# Match PANDA_LIGHTWEIGHT_SECRET in the private container; at least 32 UTF-8 bytes.
PANDA_AGENT_LIGHTWEIGHT_SECRET=
# Separate 32-byte lowercase hex BFF/database finalization key. Never send to the worker.
PANDA_AGENT_LIGHTWEIGHT_DB_KEY=

# Optional read-only Admin discovery adapter; does not enable customer execution.
# Start only the reviewed, isolated OpenCode 2.2.2 inspection supervisor below.
# Discovery uses its owner-private descriptor, not a URL/password from this file.
PANDA_AGENT_OPENCODE_INSPECTION_ENABLED=false
# Enable only after the additive native journal migration is applied to the selected development project.
# Keep journal routing on for existing receipts even when new-message selection is off.
PANDA_AGENT_NATIVE_JOURNAL_ENABLED=false
PANDA_AGENT_NATIVE_NEW_MESSAGES=false
# Local basic-RAG route intent only. Provider admission remains hard-off until verified.
PANDA_AGENT_BASIC_RAG_NEW_MESSAGES=false
# Hosted owner/Admin main-chat RAG; requires the existing reviewed grounded profile.
PANDA_AGENT_MAIN_RAG_ENABLED=false
# Removes the hosted owner's cumulative testing allowance after migration 20261110150000.
# Provider receipts, request bounds, source/access checks and the local ledger remain enforced.
PANDA_AGENT_MAIN_CHAT_UNCAPPED=false
# Absolute owner-private supervisor descriptor; never reuse a generation, secret or native state directory.
# Missing descriptor disables native observation. Inference is hard-disabled in source regardless of these flags.
PANDA_AGENT_NATIVE_RUNTIME_FILE=

{
  "name": "pandabyte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "node --test tests/auth-routes.test.mjs",
    "test:backend": "node --env-file=.env.local --test tests/insforge-access.test.mjs",
    "test:unit": "node --test tests/account-profile.test.mjs tests/account-files-validation.test.mjs tests/theme.test.mjs tests/site-navigation.test.mjs tests/admin-validation.test.mjs tests/editorial-validation.test.mjs tests/auth-return-path.test.mjs tests/account-addresses.test.mjs tests/insforge-dependency.test.mjs tests/public-record.test.mjs tests/catalog-query.test.mjs tests/editorial-public.test.mjs tests/cart-validation.test.mjs components/cart/cart-utils.test.mjs components/cart/guest-cart-store.test.mjs",
    "test:access": "node --env-file=.env.local tests/phase2-isolation.mjs",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:shell": "node --test tests/site-shell-routes.test.mjs",
    "test:publishing": "node --env-file=.env.local tests/phase3-publishing.mjs",
    "test:addresses": "node --env-file=.env.local tests/account-addresses-isolation.mjs",
    "test:storefront": "node --env-file=.env.local tests/phase4-storefront.mjs",
    "test:cart": "node --env-file=.env.local tests/phase5-cart.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.20",
    "@insforge/sdk": "1.5.2",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "@insforge/shared-schemas": {
      "zod": "4.6.7"
    }
  },
  "packageManager": "npm@11.16.0"
}
